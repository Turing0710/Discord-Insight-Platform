# Optional local defaults. Users can also paste DISCORD_TOKEN in the web UI.
DISCORD_TOKEN=
DISCORD_EXPORTER_DIR=./tools/DiscordChatExporter.Cli
EXPORT_OUTPUT_DIR=./exports
EXPORT_TIMEOUT_SECONDS=1800
CORS_ORIGINS=*

# Optional legacy backend /api/analyze route. The current frontend opens ChatGPT directly and does not require this.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANALYZE_MAX_MESSAGES=300
